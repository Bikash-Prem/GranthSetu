# Copy to .env and fill in. NEVER commit .env.

# --- Gemma (required for the agent, rerank, explanations and Scan to Learn) ---
GEMINI_API_KEY=
# Leave empty to auto-pick the best Gemma 4 model your key can see
# (run: python backend/scripts/smoke_live.py to list them)
GEMMA_MODEL=
GEMMA_VISION_MODEL=
LLM_PROVIDER=auto            # auto | gemini | ollama | none

# --- Embeddings: EmbeddingGemma via Ollama is recommended (open weights, runs locally) ---
# ollama pull embeddinggemma
EMBEDDING_PROVIDER=auto      # auto | ollama | sentence_transformers | gemini | hash
OLLAMA_URL=http://localhost:11434          # used by `make dev`
DOCKER_OLLAMA_URL=http://host.docker.internal:11434   # used inside docker compose (use http://ollama:11434 with the local-ai profile)
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_LLM_MODEL=gemma4      # offline mode: any local Gemma tag you have pulled

# --- Storage. Leave empty for lite mode (SQLite + in-process cache/queue) ---
DATABASE_URL=
DATABASE_READ_URL=
REDIS_URL=
# Required by docker compose. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
REPLICATION_PASSWORD=

# --- Accounts and library management ---
# There is NO default administrator. Create one after the first start:
#   docker compose run --rm migrate python -m granthsetu.manage create-admin --email you@college.edu
COOKIE_SECURE=false          # set true when served over HTTPS
REGISTRATION_OPEN=true       # false: only administrators create accounts
REQUIRE_SEPARATE_REVIEWER=false   # true: the submitter may not review or verify rights for their own submission
LIBRARIAN_CAN_VERIFY_RIGHTS=true  # false: only rights managers verify rights
SESSION_TTL_HOURS=12
MAX_BOOK_BYTES=52428800      # 50 MB upload limit (the gateway allows 55 MB on /api/manage/)
OCR_LANGS=eng                # the Docker image installs eng+kan+hin and sets this itself
STORAGE_DIR=data/private_files   # lite mode only; docker uses a private volume at /data/files
CORS_ORIGINS=                # leave empty: the app is served same-origin

# --- Platform ---
# Scoped token for n8n/cron: may only trigger open-library harvesting. At least 24 random characters.
AUTOMATION_TOKEN=
AUTO_SEED=true               # fetch the seed topics live on first start
REFRESH_INTERVAL_S=0         # >0: worker re-fetches seed topics periodically (or let n8n do it)
PORT=8080
REPO_URL=                    # e.g. https://github.com/you/granthsetu (enables "Open issue" on the Gap Board)
